# Copy this file to .env and adjust as needed.
# docker compose reads this file automatically; the PHP app also reads it at startup.

# Web
APP_ENV=dev
APP_PORT=8080
PMA_PORT=8081
# Set to 1 when serving over HTTPS in production (adds Secure flag to session cookie)
SESSION_SECURE=0

# Database
DB_HOST=db
DB_PORT=3306
DB_PORT_EXPOSED=3306
DB_NAME=reselltrack
DB_USER=reselltrack
DB_PASSWORD=reselltrack
DB_ROOT_PASSWORD=rootsecret

# TLS — Aiven CA certificate (path relative to project root, or absolute)
# Download from: Aiven Console > Service > Overview > Download CA cert
# Save as certs/aiven-ca.pem and commit it (public info, not a secret).
# When this file is absent (local Docker dev), Database::connection() connects without TLS.
DB_SSL_CA=certs/aiven-ca.pem

# Production Aiven connection (supplied via Vercel env vars + operator's local .env)
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=<port from Aiven Console — may not be 3306>
# DB_NAME=defaultdb     # Must match the actual Aiven database name (often defaultdb)
# DB_USER=avnadmin
# DB_PASSWORD=<from Aiven Console — Users tab>

# Cloudinary (image storage)
# Create a free account (no credit card) at cloudinary.com; the Dashboard shows
# Cloud name, API Key and API Secret. Set these in Vercel env vars (Key + Secret = Sensitive).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
