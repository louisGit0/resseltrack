# Copy this file to .env and adjust as needed.
# docker compose reads this file automatically; the PHP app also reads it at startup.

# Web
APP_ENV=dev
APP_PORT=8080
PMA_PORT=8081
# Set to 1 when serving over HTTPS in production (adds Secure flag to session cookie)
SESSION_SECURE=0

# Database
DB_HOST=db
DB_PORT=3306
DB_PORT_EXPOSED=3306
DB_NAME=reselltrack
DB_USER=reselltrack
DB_PASSWORD=reselltrack
DB_ROOT_PASSWORD=rootsecret
