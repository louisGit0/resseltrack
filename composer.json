{
    "name": "reselltrack/app",
    "description": "Suivi d'achat-revente avec calcul de rentabilite (PHP MVC maison).",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "aws/aws-sdk-php": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "vercel": "@composer dump-autoload --optimize"
    },
    "config": {
        "sort-packages": true
    }
}
